---
interface Props { size?: number; text?: boolean; class?: string }
const { size = 30, text = true, class: className } = Astro.props;
const id = `lg${Math.random().toString(36).slice(2, 8)}`;
---
<span class:list={[text ? "logo-word" : "logo-mark", className]} aria-label={text ? "patina" : undefined}>
  <svg width={text ? undefined : size} height={text ? undefined : size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <defs>
      <linearGradient id={`${id}-cu`} x1="6" y1="3" x2="26" y2="26" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#ffcfa6" />
        <stop offset="0.35" stop-color="#e09a63" />
        <stop offset="1" stop-color="#8f4c28" />
      </linearGradient>
      <linearGradient id={`${id}-ver`} x1="4" y1="30" x2="22" y2="12" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#2c7c69" />
        <stop offset="1" stop-color="#7fe0c8" />
      </linearGradient>
      <mask id={`${id}-m`} maskUnits="userSpaceOnUse" x="0" y="0" width="32" height="32">
        <rect x="5" y="6" width="5.5" height="23.5" rx="2.75" fill="#fff" />
        <circle cx="17.5" cy="13.75" r="7.6" stroke="#fff" stroke-width="5.2" />
      </mask>
    </defs>
    <g mask={`url(#${id}-m)`}>
      <rect width="32" height="32" fill={`url(#${id}-cu)`} />
      <path d="M0 32V19.5c3.2-1.6 5.4 1.8 8.6 0.6 3.3-1.2 4-4.6 7.4-4.4 3 .2 3.6 3.4 6.6 3.1 3.6-.4 5.6-4.9 9.4-4.3V32Z" fill={`url(#${id}-ver)`} />
      <circle cx="23.6" cy="8.2" r="1.5" fill="#7fe0c8" />
      <circle cx="21.2" cy="5.9" r="0.9" fill="#7fe0c8" />
      <circle cx="25.6" cy="12.4" r="0.8" fill="#5fd0b4" />
    </g>
  </svg>{text && <span class="rest" aria-hidden="true">atina</span>}
</span>

<style>
  .logo-mark { display: inline-flex; }
  .logo-word {
    display: inline-flex; align-items: baseline; white-space: nowrap;
    font-family: var(--display); font-weight: 800; font-variation-settings: "wdth" 78, "opsz" 96;
    letter-spacing: -0.05em; line-height: 1;
  }
  .logo-word svg {
    width: var(--pm, 0.86em); height: var(--pm, 0.86em); flex: none;
    margin-left: calc(var(--pm, 0.86em) * -0.15);
    margin-right: calc(var(--pm, 0.86em) * -0.17);
    transform: translateY(calc(var(--pm, 0.86em) * 0.266));
    align-self: baseline;
  }
</style>
